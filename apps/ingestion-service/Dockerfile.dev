FROM node:22-slim

WORKDIR /app

# Xvfb = virtual display for headed Chromium.
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11-utils dbus dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/ingestion-service/package.json apps/ingestion-service/
COPY apps/websocket-service/package.json apps/websocket-service/
COPY packages/shared/package.json packages/shared/

RUN npm install

RUN npx playwright install --with-deps chromium

COPY . .

# Copy the entrypoint to /usr/local/bin — OUTSIDE /app — so the dev bind mount
# (.:/app) doesn't shadow it.
COPY apps/ingestion-service/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# The compose `command:` (npx nodemon … src/index.js) is passed as args to the
# entrypoint, so nodemon (and the node it spawns) run under the Xvfb display.
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["npm", "run", "ingestion:dev"]